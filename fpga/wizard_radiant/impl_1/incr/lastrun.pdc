# Reset
ldc_set_location -site {34} [get_ports nrst_in]

# HUB75 panel (same as display_radiant/fpgaDisplayConnections.pdc)
ldc_set_location -site {46} [get_ports OE]
ldc_set_location -site {45} [get_ports LAT]
ldc_set_location -site {3} [get_ports CLK]
ldc_set_location -site {44} [get_ports D]
ldc_set_location -site {9} [get_ports C]
ldc_set_location -site {18} [get_ports B]
ldc_set_location -site {13} [get_ports A]
ldc_set_location -site {12} [get_ports E]
ldc_set_location -site {20} [get_ports B2]
ldc_set_location -site {2} [get_ports G2]
ldc_set_location -site {47} [get_ports R2]
ldc_set_location -site {48} [get_ports B1]
ldc_set_location -site {4} [get_ports G1]
ldc_set_location -site {6} [get_ports R1]

# SPI from MCU (same as fpga_spi/asdf.pdc EXCEPT cs: P6 is now R1, so cs moved to P10)
ldc_set_location -site {21} [get_ports sck]
ldc_set_location -site {19} [get_ports sdi]
ldc_set_location -site {11} [get_ports sdo]
ldc_set_location -site {10} [get_ports cs]

# Debug LED: on while the panel is enabled
ldc_set_location -site {38} [get_ports led]
